# Test environment values (docker-compose.test.yml). Not secrets: they only
# exist in the throwaway local InfluxDB. Defined once here and shared by both
# services, so the processor and the database always agree.

# Processor side: fills the placeholders in config/mtc_config.example.yaml.
# The agent is the simulated one (dev/fake_agent.py), see docker-compose.test.yml
MTC_AGENT_URL=http://fake_agent/current
INFLUX_URL=http://influxdb:8086
INFLUX_ORG=test-org
INFLUX_BUCKET=MACHINE_DATA
INFLUX_TOKEN=local-test-token

# InfluxDB side: first-start setup of the same org, bucket and token
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=local-test-password
DOCKER_INFLUXDB_INIT_ORG=${INFLUX_ORG}
DOCKER_INFLUXDB_INIT_BUCKET=${INFLUX_BUCKET}
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=${INFLUX_TOKEN}
