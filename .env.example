# Copy to .env and fill in. .env is not version controlled.
# These values fill the ${VAR} placeholders in config/mtc_config.yaml.

# MTConnect agent endpoint, e.g. http://agent:5000/current
# Empty = read ingest.sample_file instead.
MTC_AGENT_URL=

# InfluxDB 2.x connection
INFLUX_URL=https://influxdb.example:8086
INFLUX_ORG=
INFLUX_BUCKET=MACHINE_DATA
INFLUX_TOKEN=

# Polling interval in seconds
POLL_INTERVAL=15

# 1 = poll once and exit (quick validation)
RUN_ONCE=0

# Logging (written to ./logs/processor.log)
PROCESSOR_LOG_LEVEL=INFO
PROCESSOR_LOG_MAX_MB=5
PROCESSOR_LOG_BACKUPS=3
